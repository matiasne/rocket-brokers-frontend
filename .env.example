# Where the router lives. Default: http://localhost:4111
# MASTER_URL=http://localhost:4111

# Supabase: sign-in for the UI and where each user's chat is stored (run
# supabase/migrations/0001_chat.sql in the project once). Both values are in the project's
# API settings; the publishable (anon) key is the public one, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
